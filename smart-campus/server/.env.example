# Server
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-campus?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_key_here_make_it_long_and_random
JWT_EXPIRE=7d

# App URL
CLIENT_URL=http://localhost:5173

# Email (Gmail + App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM=Smart Campus <your_gmail@gmail.com>
